package com.sharedcanvas.config;

import com.sharedcanvas.model.*;
import com.sharedcanvas.repository.*;
import org.springframework.boot.CommandLineRunner;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
public class DataSeeder {

    @Bean
    CommandLineRunner seed(
            ArtistRepository artists,
            GalleryRoomRepository rooms,
            PaintingRepository paintings) {

        return args -> {

            if (paintings.count() > 0) {
    for (Painting p : paintings.findAll()) {

        if ("Starry Night".equals(p.getTitle())) {
            p.setImageUrl("http://localhost:5173/images/starry-night.jpg");
        }

        if ("Water Lilies".equals(p.getTitle())) {
            p.setImageUrl("http://localhost:5173/images/water-lilies.jpg");
        }

        if ("The Kiss".equals(p.getTitle())) {
            p.setImageUrl(
                "https://commons.wikimedia.org/wiki/Special:Redirect/file/The_Kiss_-_Gustav_Klimt_-_Google_Cultural_Institute.jpg"
            );
        }

        paintings.save(p);
    }

    return;
}

            Artist vanGogh = artists.save(new Artist(
                    "Vincent van Gogh",
                    "Netherlands",
                    "Post-Impressionist painter known for expressive color and energetic brushwork."
            ));

            Artist monet = artists.save(new Artist(
                    "Claude Monet",
                    "France",
                    "French Impressionist painter known for studies of light, atmosphere and color."
            ));

            Artist klimt = artists.save(new Artist(
                    "Gustav Klimt",
                    "Austria",
                    "Austrian symbolist painter associated with the Vienna Secession."
            ));

            GalleryRoom room = rooms.save(
                    new GalleryRoom("DEMO01", "The Shared Canvas", "Classic")
            );

            paintings.save(new Painting(
                    "Starry Night",
                    1889,
                    "Oil on canvas",
                    "A night landscape filled with swirling stars and expressive movement.",
                    "http://localhost:5173/images/starry-night.jpg",
                    vanGogh,
                    room
            ));

            paintings.save(new Painting(
                    "Water Lilies",
                    1906,
                    "Oil on canvas",
                    "A peaceful study of water, reflections and floating lilies.",
                    "http://localhost:5173/images/water-lilies.jpg",
                    monet,
                    room
            ));

            paintings.save(new Painting(
                    "The Kiss",
                    1908,
                    "Oil and gold leaf",
                    "A celebrated work combining intimate figures with decorative pattern.",
                    "https://commons.wikimedia.org/wiki/Special:Redirect/file/The_Kiss_-_Gustav_Klimt_-_Google_Cultural_Institute.jpg",
                    klimt,
                    room
            ));
        };
    }
}